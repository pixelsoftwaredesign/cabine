# Serveur
PORT=3000
NODE_ENV=development

# Base de données MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/cabine_iot

# Broker MQTT Mosquitto
MQTT_BROKER=mqtt://127.0.0.1:1883

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Commission plateforme (0.15 = 15% reversés à la plateforme, le reste au partenaire)
PLATFORM_FEE_RATE=0.15

# Prix par défaut d'une cabine
DEFAULT_PRICE_PER_HOUR=12