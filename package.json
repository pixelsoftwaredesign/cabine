{
  "name": "cabine-iot-backend",
  "version": "1.0.0",
  "description": "Backend IoT de la cabine intelligente : réservation en ligne, mode partenaire, MQTT, voix",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "seo": "node tools/seo/inject.mjs",
    "seo:check": "node tools/seo/check.mjs",
    "seo:indexnow": "node tools/seo/indexnow.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "html:check": "node tools/html-check.mjs",
    "verify": "npm run seo:check && npm run i18n:check && npm run html:check",
    "test": "npm run verify",
    "deploy:pages": "npx wrangler pages deploy public --project-name mycabine"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "mqtt": "^5.10.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.5",
    "stripe": "^16.12.0"
  }
}